import re
import argparse

def extract_usernames(file_path):
    with open(file_path, "r", encoding="utf-8") as file:
        content = file.read()

    # This pattern matches:
    # - https://www.instagram.com/username
    # - https://instagram.com/username/
    # - https://www.instagram.com/_u/username/
    pattern = r'instagram\.com/(?:_u/)?([a-zA-Z0-9._]+)'

    usernames = set(re.findall(pattern, content))
    return usernames

def main():
    parser = argparse.ArgumentParser(description="Find users who don't follow you back.")
    parser.add_argument("-i", "--input", required=True, help="following.html")
    parser.add_argument("-e", "--export", required=True, help="followers.html")
    args = parser.parse_args()

    following = extract_usernames(args.input)
    followers = extract_usernames(args.export)

    not_following_back = following - followers

    print("\n----- ACCOUNTS NOT FOLLOWING YOU BACK -----")
    if not_following_back:
        for username in sorted(not_following_back):
            print(f"https://instagram.com/{username}")
    else:
        print("✔️ Everyone is following you back!")

if __name__ == "__main__":
    main()
